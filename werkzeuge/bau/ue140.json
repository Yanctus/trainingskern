  "players",
  "balls,arrows"
 ],
 "coaching_points": [
  "Genau und mit dem richtigen Tempo passen, vor allem nach außen",
  "Saubere Technik in Leiter und Hürden, nichts umstoßen",
  "Vor der Flanke den Kopf heben und den Lauf des Stürmers sehen",
  "Eiskalt abschließen und mit gutem Timing in den Strafraum laufen"
 ],
